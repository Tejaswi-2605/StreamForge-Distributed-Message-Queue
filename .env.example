# Copy to .env and set a local password before starting Docker Compose.

POSTGRES_PASSWORD=
POSTGRES_DSN=postgres://streamforge@127.0.0.1:55432/streamforge?sslmode=disable
REDIS_ADDR=127.0.0.1:56379
BROKER_ID=0
BROKER_ADDRESS=127.0.0.1:9001
METRICS_ADDRESS=127.0.0.1:9101
BROKER_LIST=127.0.0.1:9001,127.0.0.1:9002,127.0.0.1:9003
DATA_DIR=data/brokers/0
MAX_MESSAGE_SIZE=1048576
SEGMENT_MAX_BYTES=16777216
INDEX_INTERVAL=64
FSYNC_MODE=fsync
MAX_INFLIGHT_REQUESTS=128
MAX_BATCH_SIZE=100
MAX_FETCH_SIZE=100
LEASE_TTL=30s
MAX_RETRIES=3
RETRY_BASE=1s
RETRY_MAX=1m
# Retention is opt-in: 0 keeps all segments. Slow consumers can lose old offsets.
RETENTION_MAX_SEGMENTS=0
RETENTION_INTERVAL=1m
